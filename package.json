{
  "name": "devix-router",
  "productName": "devix",
  "desktopName": "devix.desktop",
  "version": "1.0.1",
  "description": "Local development proxy router with an Electron GUI",
  "homepage": "https://github.com/barbaruiva/devix",
  "repository": {
    "type": "git",
    "url": "https://github.com/barbaruiva/devix.git"
  },
  "main": "electron/main.js",
  "dependencies": {
    "chalk": "^4.1.2",
    "express": "^4.17.3",
    "http-proxy-middleware": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "vite": "^5.4.10",
    "vitest": "^4.1.11",
    "vue": "^3.5.13",
    "wait-on": "^8.0.3"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run build:renderer && electron . --no-sandbox",
    "start:cli": "node ./main.js",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:renderer": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dist": "npm run build:renderer && electron-builder --publish never",
    "dist:linux": "npm run build:renderer && electron-builder --linux --publish never",
    "dist:win": "npm run build:renderer && electron-builder --win --publish never"
  },
  "build": {
    "appId": "io.github.barbaruiva.devix",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "src/runtime/**",
      "!src/runtime/**/*.test.js",
      "dist/renderer/**",
      "config-template.json",
      "proxies-template.json",
      "package.json"
    ],
    "publish": null,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "devix",
      "syncDesktopName": true,
      "category": "Development",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "${name}_${version}_${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": {
    "name": "barbaruiva",
    "email": "19174237+barbaruiva@users.noreply.github.com"
  },
  "license": "ISC",
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.21.5": true
  }
}
