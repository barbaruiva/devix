{
  "port": 12345,
  "proxies": [
    {
      "name": "Posts",
      "path": "/posts",
      "routes": {
        "local": {
          "destination": "http://localhost:3001"
        },
        "jsonplaceholder": {
          "destination": "https://jsonplaceholder.typicode.com"
        },
        "dummyjson": {
          "destination": "https://dummyjson.com"
        }
      }
    },
    {
      "name": "Users",
      "path": "/users",
      "routes": {
        "local": {
          "destination": "http://localhost:3001"
        },
        "reqres": {
          "destination": "https://reqres.in/api"
        }
      }
    },
    {
      "name": "HTTP Debug",
      "path": "/debug",
      "routes": {
        "httpbin": {
          "destination": "https://httpbin.org"
        }
      }
    }
  ]
}
